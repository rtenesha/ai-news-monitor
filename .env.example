# Бесплатный API Groq — console.groq.com, без карты
GROQ_API_KEY=your_groq_api_key_here

# Telegram бот — получить у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Твой Telegram chat_id — узнать у @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Автоотправка: не задан или не 1 — скрипты только собирают и логируют новости;
# 1 — снова присылать дайджесты и алерты в Telegram
# TELEGRAM_AUTO_SEND=1